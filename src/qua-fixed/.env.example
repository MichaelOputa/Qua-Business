# ── Frontend (Vite) ───────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# URL of the Express API (change for production)
VITE_API_URL=http://localhost:3001

# ── Backend (Express / Node) ──────────────────────────────────────────────────
# PostgreSQL connection string (Railway, Supabase, Neon, etc.)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Supabase service-role key — SERVER ONLY, never expose to client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# CORS — frontend origin the server allows
CLIENT_ORIGIN=http://localhost:5173

# Port the Express server listens on
PORT=3001

# ── Contact Form Email (optional) ─────────────────────────────────────────────
# If not set, messages are only saved to the database
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
CONTACT_TO_EMAIL=industriesqua@gmail.com
